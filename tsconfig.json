{
  // Solution-style root: it owns no files of its own, it just wires the two real
  // projects together. Editors use these references to pick the right compiler
  // options per file; `pnpm typecheck` (tsc -b) checks both.
  //
  // The split exists because the halves run in different places: src/gui and
  // src/gui-mobile are browser code bundled by Vite, everything else is Node.
  // See each config for what that changes.
  "files": [],
  "references": [
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.gui.json" },
    { "path": "./tsconfig.gui-mobile.json" }
  ]
}
