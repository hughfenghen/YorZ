{
  "name": "@yorz/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "YorZ CLI — install/uninstall the yorz-spec skill into Claude Code / OpenCode.",
  "bin": {
    "yorz": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:gui",
    "build:cli": "vite build",
    "build:gui": "vite build --config vite.gui.config.ts",
    "dev": "vite build --watch",
    "dev:gui": "vite --config vite.gui.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,css}\""
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@solidjs/router": "^0.16.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "markdown-it": "^14.2.0",
    "prettier": "^3.4.0",
    "solid-js": "^1.9.13",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^2.1.0"
  }
}
