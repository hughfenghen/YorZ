{
  "name": "@yorz/cli",
  "version": "0.1.1",
  "type": "module",
  "description": "",
  "bin": {
    "yorz": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai",
    "agent",
    "spec-driven",
    "decision-os",
    "claude-code",
    "opencode",
    "workflow",
    "cli"
  ],
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/YorZ.git"
  },
  "homepage": "https://github.com/anomalyco/YorZ#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:gui",
    "build:cli": "vite build",
    "build:gui": "vite build --config vite.gui.config.ts",
    "dev": "pnpm run build && concurrently -k -n cli,gui,serve \"vite build --watch\" \"vite build --config vite.gui.config.ts --watch\" \"node dist/cli/index.js serve\"",
    "dev:cli": "vite build --watch",
    "dev:gui-build": "vite build --config vite.gui.config.ts --watch",
    "dev:gui": "vite --config vite.gui.config.ts",
    "test": "vitest run",
    "test:agent": "node scripts/test-agent.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,css}\"",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.25",
    "markdown-it": "^14.2.0",
    "trash": "^10.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@solidjs/router": "^0.16.1",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^25.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.0.0",
    "prettier": "^3.4.0",
    "solid-js": "^1.9.13",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^2.1.0"
  }
}
